# GemReady backend. Every key is optional: with none set it runs on sample data.

PORT=8790

# 'mock' (sample cards + sample graded prices, labeled "Sample data" in the app)
# or 'live' (full Pokémon catalog + TCGplayer raw prices via tcgcsv.com, daily).
DATA_MODE=mock
# 0 = full catalog (~19k cards). N = only the newest N sets (faster boot).
CATALOG_SET_LIMIT=0

# Postgres (Supabase / Neon / Render). Unset = JSON file at data/store.json —
# fine for dev, NOT for production (most hosts wipe the disk on deploy).
DATABASE_URL=

# Graded sale prices. https://www.pricecharting.com/api-documentation (paid).
# Without it, live mode shows "No recent sales" on graded rows.
PRICECHARTING_API_TOKEN=

# PSA cert lookup on "Add Slab Result". Free token: https://www.psacard.com/publicapi
PSA_API_TOKEN=

# Price-alert push notifications. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Where opt-in training crops are written. Use a persistent disk or a mounted
# bucket in production.
TRAINING_DIR=

# Override the model manifest location (default ../model/manifest.json).
MODEL_MANIFEST=

# Enables GET /api/admin/slab-results for model/train.py. Long random string.
ADMIN_TOKEN=
